---
import Post from '../../../views/Post.astro';
import { getPosts, listed } from '../../../lib/posts';
export async function getStaticPaths() {
  // every piece gets a page (ideas too, for the preview); "Piece n of N" counts only the listed ones
  const posts = await getPosts('ko', { all: true }), shown = posts.filter(listed);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, n: shown.indexOf(post) + 1, of: shown.length } }));
}
---
<Post lang="ko" {...(Astro.props as any)} />
