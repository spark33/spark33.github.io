---
// Specimen for the sola piece: a day of its messages, played back. Illustrative until a real, redacted day replaces it.
import { forLang } from '../data/site';
import type { Lang } from '../i18n';
interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const { SOLA_DAY } = forLang(lang);
const W = {
  en: { aria: 'An illustrative day with sola', how: 'How it runs', runs: ['Lives in Slack. One message a day, unless something needs me.', 'Reads and writes Google Calendar, Gmail (drafts only) and Sheets.', 'Remembers through a memory kept in git. Heavy jobs go to GitHub Actions.'],
    replay: 'Replay the day', replayFF: 'Play the day again', cap: 'An illustrative day; the numbers are made up.' },
  ko: { aria: 'sola와 보낸 하루(예시)', how: '돌아가는 방식', runs: ['슬랙 안에서 돌아가요. 제가 꼭 봐야 할 일이 없으면 메시지는 하루 한 번만 보내요.', '구글 캘린더, 지메일(초안만), 시트를 읽고 써요.', '기억은 git에 저장한 메모리에 남겨요. 무거운 작업은 GitHub Actions에 넘겨요.'],
    replay: '하루 다시 보기', replayFF: '하루를 다시 재생', cap: '예시로 꾸민 하루라 숫자는 지어낸 거예요.' },
}[lang];
---
<figure class="fig">
  <div class="medium agent"><div class="in">
    <ol class="log" aria-label={W.aria}>
      {SOLA_DAY.map((l) => <li class={l.me ? 'me' : ''}><time class="num">{l.t}</time><div><span class="who">{l.who}</span><p class="msg">{l.m}</p></div></li>)}
    </ol>
    <div class="runs"><b>{W.how}</b>{W.runs.map((r) => <span>{r}</span>)}<button class="replay" data-ff={W.replayFF}>{W.replay}</button></div>
  </div><p class="cap faint">{W.cap}</p></div>
</figure>

<script>
  import { RM, everyPage, onLeave } from '../scripts/site';
  everyPage(() => document.querySelectorAll<HTMLElement>('.medium.agent').forEach((m) => {
    const items = [...m.querySelectorAll<HTMLElement>('.log li')]; let run = 0;
    const play = async () => { const me = ++run; items.forEach((li) => li.classList.remove('on'));
      for (const li of items) { if (me !== run) return; li.classList.add('on'); if (!RM()) await new Promise((r) => setTimeout(r, li.classList.contains('me') ? 500 : 900)); } };
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); play(); } }, { threshold: .35 }); io.observe(m);
    m.querySelector<HTMLElement>('.replay')!.onclick = play;
    onLeave(() => { io.disconnect(); run++; });
  }));
</script>
