---
// Specimen for "Paper, grain and a moon": the parts the site is made of, live.
const LIGHT = ['#eeeadf', '#e4dfd2', '#6b665c', '#57534a', '#1b1a17'], DARK = ['#12110f', '#1b1a17', '#888376', '#a8a295', '#e9e3d4'];
const TRACKS = [['press', '--t-press', '150'], ['move', '--t-move', '280'], ['reveal', '--t-reveal', '420']];
---
<figure class="fig">
  <div class="medium system"><div class="in">
    <div class="cell"><b>Paper</b><div class="sw">{LIGHT.map((c) => <span style={`background:${c}`} title={c}></span>)}</div><div class="sw">{DARK.map((c) => <span style={`background:${c}`} title={c}></span>)}</div><small>한지 by day, ink by night. Grain from two noise layers.</small></div>
    <div class="cell"><b>Type</b><div class="aa">Aa</div><small>Newsreader, optical sizes 6–72. Sizes 15 · 18 · 24 · 44.</small></div>
    <div class="cell"><b>Moon</b><div class="phases" data-phases></div><small>Fills as you read. The ringed one is tonight in Seoul.</small></div>
    <div class="cell"><b>Motion</b><div class="tracks">{TRACKS.map(([n, v, ms]) => <div class="track"><span class="num">{n} {ms}</span><span class="r2"><i style={`--d:var(${v})`}></i></span></div>)}</div><button class="run" data-ff="Run the three timings">Run</button></div>
  </div><p class="cap faint">No screenshots for this one: it's the page you're on.</p></div>
</figure>

<script>
  import { phaseNow, moonPath, everyPage } from '../scripts/site';
  everyPage(() => document.querySelectorAll<HTMLElement>('.medium.system').forEach((m) => {
    const k = Math.round(phaseNow() * 8) % 8;
    m.querySelector('[data-phases]')!.innerHTML = [0, 1, 2, 3, 4, 5, 6, 7].map((i) => `<svg viewBox="0 0 18 18" class="${i === k ? 'now' : ''}"><circle cx="9" cy="9" r="7.5" fill="var(--moon-dark)"/><path fill="var(--fg)" d="${moonPath(Math.min(Math.max(i / 8, .001), .999), 7.5, 9)}"/></svg>`).join('');
    const tr = m.querySelector('.tracks')!; m.querySelector<HTMLElement>('.run')!.onclick = () => tr.classList.toggle('go');
  }));
</script>
